#!/usr/bin/env bash
set -Eeuo pipefail

readonly CONFIG=/etc/cachy-freeze-grub-auth.conf
[[ -r $CONFIG ]] || exit 0

# The root-generated file contains only the username and PBKDF2 hash; the plain
# password is never written to disk.
# shellcheck source=/dev/null
source "$CONFIG"

[[ ${GRUB_AUTH_USER:-} =~ ^[a-zA-Z0-9_.-]+$ ]] || exit 1
[[ ${GRUB_AUTH_HASH:-} == grub.pbkdf2.* ]] || exit 1

cat <<EOF
set superusers="$GRUB_AUTH_USER"
password_pbkdf2 $GRUB_AUTH_USER $GRUB_AUTH_HASH
EOF
