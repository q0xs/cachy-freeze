#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG=${CACHY_FREEZE_CONFIG:-/etc/cachy-freeze.conf}
BOOT_DIR=${CACHY_FREEZE_BOOT_DIR:-/boot}
[[ -r $CONFIG ]] || exit 0
# shellcheck source=../etc/cachy-freeze.conf
source "$CONFIG"

root_uuid=$(findmnt -n -o UUID /)
[[ -n $root_uuid ]] || exit 0

kernel_args=$(sed -n \
  "s/^GRUB_CMDLINE_LINUX_DEFAULT=['\"]\\(.*\\)['\"]$/\\1/p" \
  /etc/default/grub)

emit_entry() {
  local title=$1 id=$2 subvol=$3 freeze_arg=$4 kernel=$5 initramfs=$6
  local access_arg=${7:-}
  local initrd_line boot_subvol=$subvol
  [[ -r $BOOT_DIR/$kernel && -r $BOOT_DIR/$initramfs ]] || return 0
  initrd_line="/$boot_subvol/boot/$initramfs"
  if [[ -r $BOOT_DIR/intel-ucode.img ]]; then
    initrd_line="/$boot_subvol/boot/intel-ucode.img $initrd_line"
  elif [[ -r $BOOT_DIR/amd-ucode.img ]]; then
    initrd_line="/$boot_subvol/boot/amd-ucode.img $initrd_line"
  fi

  cat <<EOF
menuentry '$title' --class cachyos --class gnu-linux --class os --id '$id' $access_arg {
    insmod gzio
    insmod part_gpt
    insmod btrfs
    search --no-floppy --fs-uuid --set=root $root_uuid
    linux /$boot_subvol/boot/$kernel root=UUID=$root_uuid rw rootflags=subvol=$subvol $freeze_arg $kernel_args
    initrd $initrd_line
}
EOF
}

emit_entry \
  'CachyOS Kurumsal - Frozen' \
  'cachyos-frozen' \
  "$ACTIVE_SUBVOL" \
  'cachy.freeze=1' \
  'vmlinuz-linux-cachyos' \
  'initramfs-linux-cachyos.img' \
  '--unrestricted'

emit_entry \
  'CachyOS Kurumsal - Maintenance' \
  'cachyos-maintenance' \
  "$MAINTENANCE_SUBVOL" \
  'cachy.freeze=0' \
  'vmlinuz-linux-cachyos' \
  'initramfs-linux-cachyos.img'
