#!/bin/sh
set -eu

CONFIG=${CACHY_FREEZE_INITRD_CONFIG:-/etc/cachy-freeze-initrd.conf}
TOP=${CACHY_FREEZE_TOP:-/run/cachy-freeze/btrfs}

log() {
  printf 'cachy-freeze: %s\n' "$*" >/dev/kmsg
}

fail() {
  log "HATA: $*"
  exit 1
}

cleanup() {
  if mountpoint -q "$TOP"; then
    umount "$TOP" || log "UYARI: $TOP ayrılamadı"
  fi
}

subvol_exists() {
  btrfs subvolume show "$TOP/$1" >/dev/null 2>&1
}

delete_subvol() {
  subvol_exists "$1" || return 0
  btrfs subvolume delete "$TOP/$1"
}

recover_interrupted_rotation() {
  if ! subvol_exists "$ACTIVE_SUBVOL" && subvol_exists "$NEXT_SUBVOL"; then
    log "Yarım kalan işlem bulundu; next active yapılıyor"
    mv "$TOP/$NEXT_SUBVOL" "$TOP/$ACTIVE_SUBVOL"
  fi

  if ! subvol_exists "$ACTIVE_SUBVOL" && subvol_exists "$PREVIOUS_SUBVOL"; then
    log "Yarım kalan işlem bulundu; previous active yapılıyor"
    mv "$TOP/$PREVIOUS_SUBVOL" "$TOP/$ACTIVE_SUBVOL"
  fi
}

main() {
  [ -r "$CONFIG" ] || fail "$CONFIG bulunamadı"
  # The file is generated by the root-only installer and embedded in initramfs.
  # shellcheck disable=SC1090
  . "$CONFIG"

  if [ -n "${ROOT_DEVICE:-}" ]; then
    device=$ROOT_DEVICE
  else
    [ -n "${ROOT_UUID:-}" ] || fail "ROOT_UUID boş"
    device="/dev/disk/by-uuid/$ROOT_UUID"
  fi
  attempts=0
  while [ ! -b "$device" ] && [ "$attempts" -lt 40 ]; do
    sleep 0.25
    attempts=$((attempts + 1))
  done
  [ -b "$device" ] || fail "Kök aygıt hazır değil: $device"

  mkdir -p "$TOP"
  trap cleanup EXIT INT TERM
  mount -t btrfs -o rw,subvolid=5 "$device" "$TOP"

  subvol_exists "$GOLDEN_SUBVOL" || fail "$GOLDEN_SUBVOL bulunamadı"
  [ "$(btrfs property get -ts "$TOP/$GOLDEN_SUBVOL" ro)" = "ro=true" ] ||
    fail "$GOLDEN_SUBVOL salt-okunur değil"

  recover_interrupted_rotation
  delete_subvol "$NEXT_SUBVOL"

  log "$GOLDEN_SUBVOL üzerinden yeni çalışma snapshot'ı oluşturuluyor"
  btrfs subvolume snapshot "$TOP/$GOLDEN_SUBVOL" "$TOP/$NEXT_SUBVOL"

  delete_subvol "$PREVIOUS_SUBVOL"
  if subvol_exists "$ACTIVE_SUBVOL"; then
    mv "$TOP/$ACTIVE_SUBVOL" "$TOP/$PREVIOUS_SUBVOL"
  fi
  mv "$TOP/$NEXT_SUBVOL" "$TOP/$ACTIVE_SUBVOL"
  sync

  log "Yeni $ACTIVE_SUBVOL hazır"
}

main "$@"
