#!/bin/sh
set -eu

CONFIG=${CACHY_FREEZE_INITRD_CONFIG:-/etc/cachy-freeze-initrd.conf}
TOP=${CACHY_FREEZE_TOP:-/run/cachy-freeze/btrfs}

log() {
  printf 'cachy-freeze: %s\n' "$*" >/dev/kmsg
}

fail() {
  log "ERROR: $*"
  exit 1
}

cleanup() {
  if mountpoint -q "$TOP"; then
    umount "$TOP" || log "WARNING: $TOP could not be unmounted"
  fi
}

subvol_exists() {
  btrfs subvolume show "$TOP/$1" >/dev/null 2>&1
}

delete_subvol() {
  subvol_exists "$1" || return 0
  btrfs subvolume delete "$TOP/$1"
}

# Recover one transaction pair using only durable subvolume names. The state
# journal is intentionally stored outside the frozen root and is not mounted
# this early in boot, so each rename has to be self-describing.
recover_pair() {
  current=$1
  candidate=$2
  previous=$3
  pending=$4
  required=$5

  if ! subvol_exists "$current" && subvol_exists "$candidate"; then
    log "Interrupted operation found; $candidate -> $current"
    mv "$TOP/$candidate" "$TOP/$current"
  fi
  if ! subvol_exists "$current" && subvol_exists "$pending"; then
    log "Interrupted operation found; $pending -> $current"
    mv "$TOP/$pending" "$TOP/$current"
  fi
  if subvol_exists "$current" && subvol_exists "$pending"; then
    delete_subvol "$previous"
    mv "$TOP/$pending" "$TOP/$previous"
  fi
  if subvol_exists "$current" && subvol_exists "$candidate"; then
    delete_subvol "$candidate"
  fi
  if [ "$required" = yes ] && ! subvol_exists "$current"; then
    fail "The interrupted operation could not recover $current"
  fi
}

read_attempts() {
  attempts=0
  if [ -r "$TOP/$STATE_SUBVOL/boot-attempts" ]; then
    IFS= read -r attempts <"$TOP/$STATE_SUBVOL/boot-attempts" || attempts=0
  fi
  case $attempts in
    '' | *[!0-9]*) attempts=0 ;;
  esac
}

write_attempts() {
  temporary="$TOP/$STATE_SUBVOL/.boot-attempts.$$"
  printf '%s\n' "$1" >"$temporary"
  mv "$temporary" "$TOP/$STATE_SUBVOL/boot-attempts"
}

finalize_transaction_journal() {
  journal="$TOP/$STATE_SUBVOL/transaction.json"
  [ -f "$journal" ] || return 0
  mv "$journal" "$TOP/$STATE_SUBVOL/transaction.initramfs-recovered.json"
  printf '%s\n' transaction-recovery >"$TOP/$STATE_SUBVOL/recovery-event"
  log "The persistent transaction journal was closed by initramfs recovery"
}

register_boot_attempt() {
  subvol_exists "$STATE_SUBVOL" || fail "$STATE_SUBVOL state subvolume was not found"
  limit=$BOOT_FAILURE_LIMIT
  if [ -r "$TOP/$STATE_SUBVOL/boot-failure-limit" ]; then
    IFS= read -r configured_limit <"$TOP/$STATE_SUBVOL/boot-failure-limit" ||
      configured_limit=
    case $configured_limit in
      2 | 3 | 4 | 5 | 6 | 7 | 8 | 9 | 10) limit=$configured_limit ;;
    esac
  fi

  read_attempts
  attempts=$((attempts + 1))
  if [ "$attempts" -ge "$limit" ]; then
    if subvol_exists "$GOLDEN_PREVIOUS_SUBVOL" &&
      [ "$(btrfs property get -ts "$TOP/$GOLDEN_PREVIOUS_SUBVOL" ro)" = "ro=true" ]; then
      log "$attempts failed boots detected; restoring the previous Golden automatically"
      delete_subvol "$FAILED_GOLDEN_SUBVOL"
      mv "$TOP/$GOLDEN_SUBVOL" "$TOP/$FAILED_GOLDEN_SUBVOL"
      mv "$TOP/$GOLDEN_PREVIOUS_SUBVOL" "$TOP/$GOLDEN_SUBVOL"
      printf '%s\n' automatic-rollback >"$TOP/$STATE_SUBVOL/recovery-event"
      attempts=1
    else
      log "WARNING: Boot failure limit reached but no previous Golden exists"
    fi
  fi
  write_attempts "$attempts"
  sync
}

main() {
  [ -r "$CONFIG" ] || fail "$CONFIG was not found"
  # The file is generated by the root-only installer and embedded in initramfs.
  # shellcheck disable=SC1090
  . "$CONFIG"

  if [ -n "${ROOT_DEVICE:-}" ]; then
    device=$ROOT_DEVICE
  else
    [ -n "${ROOT_UUID:-}" ] || fail "ROOT_UUID is empty"
    device="/dev/disk/by-uuid/$ROOT_UUID"
  fi
  attempts=0
  while [ ! -b "$device" ] && [ "$attempts" -lt 40 ]; do
    sleep 0.25
    attempts=$((attempts + 1))
  done
  [ -b "$device" ] || fail "Root device is not ready: $device"

  mkdir -p "$TOP"
  trap cleanup EXIT INT TERM
  mount -t btrfs -o rw,subvolid=5 "$device" "$TOP"

  recover_pair \
    "$GOLDEN_SUBVOL" \
    "$GOLDEN_NEXT_SUBVOL" \
    "$GOLDEN_PREVIOUS_SUBVOL" \
    "$GOLDEN_PENDING_SUBVOL" \
    yes
  recover_pair \
    "$ACTIVE_SUBVOL" \
    "$NEXT_SUBVOL" \
    "$PREVIOUS_SUBVOL" \
    "$ACTIVE_PENDING_SUBVOL" \
    no

  finalize_transaction_journal
  register_boot_attempt

  [ "$(btrfs property get -ts "$TOP/$GOLDEN_SUBVOL" ro)" = "ro=true" ] ||
    fail "$GOLDEN_SUBVOL is not read-only"
  delete_subvol "$NEXT_SUBVOL"

  log "Creating a new runtime snapshot from $GOLDEN_SUBVOL"
  btrfs subvolume snapshot "$TOP/$GOLDEN_SUBVOL" "$TOP/$NEXT_SUBVOL"

  delete_subvol "$PREVIOUS_SUBVOL"
  if subvol_exists "$ACTIVE_SUBVOL"; then
    mv "$TOP/$ACTIVE_SUBVOL" "$TOP/$PREVIOUS_SUBVOL"
  fi
  mv "$TOP/$NEXT_SUBVOL" "$TOP/$ACTIVE_SUBVOL"
  boot_id=$(cat /proc/sys/kernel/random/boot_id)
  case $boot_id in
    ????????-????-????-????-????????????) ;;
    *) fail "The current boot id is invalid" ;;
  esac
  marker="$TOP/$STATE_SUBVOL/active-reset-boot-id"
  temporary="$TOP/$STATE_SUBVOL/.active-reset-boot-id.$$"
  printf '%s\n' "$boot_id" >"$temporary"
  mv "$temporary" "$marker"
  sync

  log "New $ACTIVE_SUBVOL is ready"
}

main "$@"
