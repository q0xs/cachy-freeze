#!/bin/sh
set -eu
set -f

CONFIG=${CACHY_FREEZE_INITRD_CONFIG:-/etc/cachy-freeze-initrd.conf}
TOP=${CACHY_FREEZE_TOP:-/run/cachy-freeze/btrfs}
BOOT_ID_FILE=${CACHY_FREEZE_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}

log() {
  printf 'cachy-freeze: %s\n' "$*" >/dev/kmsg
}

fail() {
  log "ERROR: $*"
  schedule_protected_thawed ||
    log "WARNING: The protected THAWED recovery boot could not be scheduled"
  exit 1
}

schedule_protected_thawed() {
  [ "${MAINTENANCE_SUBVOL:-}" = "@" ] || return 1
  mountpoint -q "$TOP" || return 1
  grub_environment="$TOP/$MAINTENANCE_SUBVOL/boot/grub/grubenv"
  [ -f "$grub_environment" ] || return 1
  command -v grub-editenv >/dev/null 2>&1 || return 1
  grub-editenv "$grub_environment" set \
    cachy_mode=thawed \
    saved_entry=cachyos-current \
    cachy_recovery=0 || return 1
  sync
  log "FROZEN reset failed; the next boot is protected THAWED"
}

cleanup() {
  if mountpoint -q "$TOP"; then
    umount "$TOP" || log "WARNING: $TOP could not be unmounted"
  fi
}

subvol_exists() {
  btrfs subvolume show "$TOP/$1" >/dev/null 2>&1
}

subvol_is_mounted() {
  target="/$1"
  mounted_roots=$(findmnt -rn -S "$device" -o FSROOT 2>/dev/null || true)
  for mounted_root in $mounted_roots; do
    [ "$mounted_root" = "$target" ] && return 0
  done
  return 1
}

delete_subvol() {
  subvol_exists "$1" || return 0
  ! subvol_is_mounted "$1" || fail "Refusing to delete mounted subvolume $1"
  btrfs subvolume delete --commit-after "$TOP/$1"
}

delete_disposable_subvol() {
  disposable=$1
  subvol_exists "$disposable" || return 0
  ! subvol_is_mounted "$disposable" ||
    fail "Refusing to delete mounted subvolume $disposable"
  disposable_id=$(btrfs inspect-internal rootid "$TOP/$disposable")
  case $disposable_id in
    '' | *[!0-9]*) fail "Btrfs returned an invalid disposable-subvolume id" ;;
  esac

  # `subvolume list -o` reports only direct children on some btrfs-progs
  # releases. Build the complete descendant set from numeric top-level IDs so
  # paths containing whitespace cannot affect either scope or deletion order.
  subvolume_records=$(btrfs subvolume list "$TOP")
  known_ids=" $disposable_id "
  deletion_ids=
  while :; do
    found_descendant=0
    while IFS= read -r record; do
      [ -n "$record" ] || continue
      # Globbing is disabled and only the fixed metadata prefix is consumed.
      # shellcheck disable=SC2086
      set -- $record
      [ "${1:-}" = "ID" ] && [ "${3:-}" = "gen" ] &&
        [ "${5:-}" = "top" ] && [ "${6:-}" = "level" ] ||
        fail "Btrfs returned a malformed subvolume record"
      nested_id=${2:-}
      parent_id=${7:-}
      case $nested_id in
        '' | *[!0-9]*) fail "Btrfs returned an invalid nested-subvolume id" ;;
      esac
      case $parent_id in
        '' | *[!0-9]*) fail "Btrfs returned an invalid parent-subvolume id" ;;
      esac
      case $known_ids in
        *" $nested_id "*) continue ;;
      esac
      case $known_ids in
        *" $parent_id "*)
          known_ids="$known_ids$nested_id "
          deletion_ids="$nested_id $deletion_ids"
          found_descendant=1
          ;;
      esac
    done <<EOF
$subvolume_records
EOF
    [ "$found_descendant" -eq 1 ] || break
  done

  for nested_id in $deletion_ids; do
    btrfs subvolume delete -i "$nested_id" "$TOP" >/dev/null
  done
  btrfs subvolume delete --commit-after "$TOP/$disposable"
}

bootable_root() {
  root=$TOP/$1
  [ -x "$root/sbin/init" ] &&
    [ -x "$root/usr/lib/systemd/systemd" ] &&
    [ -r "$root/etc/os-release" ] &&
    [ -f "$root/boot/vmlinuz-linux-cachyos" ] &&
    [ -f "$root/boot/initramfs-linux-cachyos.img" ]
}

validate_golden() {
  subvol_exists "$GOLDEN_SUBVOL" || fail "The Golden baseline is missing"
  [ "$(btrfs property get -ts "$TOP/$GOLDEN_SUBVOL" ro)" = "ro=true" ] ||
    fail "The Golden baseline is not read-only"
  bootable_root "$GOLDEN_SUBVOL" ||
    fail "The Golden baseline has no usable init or required boot files"
}

validate_active() {
  name=$1
  subvol_exists "$name" || fail "The disposable runtime is missing: $name"
  [ "$(btrfs property get -ts "$TOP/$name" ro)" = "ro=false" ] ||
    fail "The disposable runtime is read-only: $name"
  bootable_root "$name" ||
    fail "The disposable runtime has no usable init or required boot files: $name"
}

# A baseline transaction keeps only transaction-scoped pending objects. If a
# reboot interrupts it before the engine closes the journal, roll back to the
# pre-transaction roots. Never turn pending objects into retained history.
recover_baseline_transaction() {
  if subvol_exists "$GOLDEN_PENDING_SUBVOL"; then
    log "Interrupted Golden replacement detected; restoring the verified predecessor"
    delete_subvol "$GOLDEN_SUBVOL"
    mv "$TOP/$GOLDEN_PENDING_SUBVOL" "$TOP/$GOLDEN_SUBVOL"
  fi
  if subvol_exists "$ACTIVE_PENDING_SUBVOL"; then
    delete_disposable_subvol "$ACTIVE_SUBVOL"
    mv "$TOP/$ACTIVE_PENDING_SUBVOL" "$TOP/$ACTIVE_SUBVOL"
  fi
  delete_subvol "$GOLDEN_NEXT_SUBVOL"
  delete_disposable_subvol "$ACTIVE_NEXT_SUBVOL"
  delete_disposable_subvol "$CAPTURE_SUBVOL"
  if [ -f "$TOP/$STATE_SUBVOL/transaction.json" ]; then
    mv \
      "$TOP/$STATE_SUBVOL/transaction.json" \
      "$TOP/$STATE_SUBVOL/transaction.initramfs-rolled-back.json"
  fi
}

main() {
  [ -r "$CONFIG" ] || fail "$CONFIG was not found"
  # Generated by the root-only installer and embedded in initramfs.
  # shellcheck disable=SC1090
  . "$CONFIG"

  [ "${MAINTENANCE_SUBVOL:-}" = "@" ] || fail "Invalid maintenance subvolume contract"
  [ "${GOLDEN_SUBVOL:-}" = "@golden" ] || fail "Invalid Golden subvolume contract"
  [ "${GOLDEN_NEXT_SUBVOL:-}" = "@golden.next" ] || fail "Invalid Golden candidate contract"
  [ "${GOLDEN_PENDING_SUBVOL:-}" = "@golden.pending" ] || fail "Invalid Golden pending contract"
  [ "${ACTIVE_SUBVOL:-}" = "@active" ] || fail "Invalid Active subvolume contract"
  [ "${ACTIVE_NEXT_SUBVOL:-}" = "@active.next" ] || fail "Invalid Active candidate contract"
  [ "${ACTIVE_PENDING_SUBVOL:-}" = "@active.pending" ] || fail "Invalid Active pending contract"
  [ "${CAPTURE_SUBVOL:-}" = "@cachy-capture" ] || fail "Invalid capture subvolume contract"
  [ "${STATE_SUBVOL:-}" = "@cachy-state" ] || fail "Invalid state subvolume contract"

  if [ -n "${ROOT_DEVICE:-}" ]; then
    case $ROOT_DEVICE in
      /dev/*) ;;
      *) fail "ROOT_DEVICE is not an absolute device path" ;;
    esac
    case $ROOT_DEVICE in
      *..*) fail "ROOT_DEVICE contains parent traversal" ;;
    esac
    device=$ROOT_DEVICE
  else
    [ -n "${ROOT_UUID:-}" ] || fail "ROOT_UUID is empty"
    case $ROOT_UUID in
      ????????-????-????-????-????????????) ;;
      *) fail "ROOT_UUID has an invalid shape" ;;
    esac
    case $ROOT_UUID in
      *[!0-9A-Fa-f-]*) fail "ROOT_UUID contains invalid characters" ;;
    esac
    device="/dev/disk/by-uuid/$ROOT_UUID"
  fi
  attempts=0
  while [ ! -b "$device" ] && [ "$attempts" -lt 40 ]; do
    sleep 0.25
    attempts=$((attempts + 1))
  done
  [ -b "$device" ] || fail "The configured root device is not ready"

  mkdir -p "$TOP"
  trap cleanup EXIT INT TERM
  mount -t btrfs -o rw,subvolid=5 "$device" "$TOP"
  subvol_exists "$STATE_SUBVOL" || fail "The CachyFreeze state subvolume is missing"

  [ -r "$BOOT_ID_FILE" ] || fail "The current boot id is unavailable"
  IFS= read -r boot_id <"$BOOT_ID_FILE" || fail "The current boot id could not be read"
  case $boot_id in
    ????????-????-????-????-????????????) ;;
    *) fail "The current boot id is invalid" ;;
  esac
  marker="$TOP/$STATE_SUBVOL/active-reset-boot-id"

  # initrd-root-fs.target can be requested more than once. A successful reset
  # is immutable for the rest of this boot: rerunning it after /sysroot has
  # mounted @active would delete the live switch-root target.
  if [ -r "$marker" ]; then
    IFS= read -r completed_boot_id <"$marker" || completed_boot_id=
    if [ "$completed_boot_id" = "$boot_id" ]; then
      validate_golden
      validate_active "$ACTIVE_SUBVOL"
      log "$ACTIVE_SUBVOL was already reset for this boot; leaving it unchanged"
      return 0
    fi
  fi
  ! mountpoint -q /sysroot ||
    fail "The switch-root target is already mounted; refusing a destructive reset"
  ! subvol_is_mounted "$ACTIVE_SUBVOL" ||
    fail "The disposable runtime is already mounted; refusing a destructive reset"

  recover_baseline_transaction
  validate_golden

  # @active is disposable by contract. Delete every prior runtime and create
  # exactly one fresh runtime from Golden; no previous runtime is retained.
  # Prepare and validate the replacement before deleting the old runtime so a
  # snapshot failure cannot strand the machine without a bootable @active.
  delete_disposable_subvol "$CAPTURE_SUBVOL"
  delete_disposable_subvol "$ACTIVE_NEXT_SUBVOL"
  delete_disposable_subvol "$ACTIVE_PENDING_SUBVOL"
  log "Creating a fresh disposable runtime from $GOLDEN_SUBVOL"
  btrfs subvolume snapshot "$TOP/$GOLDEN_SUBVOL" "$TOP/$ACTIVE_NEXT_SUBVOL"
  validate_active "$ACTIVE_NEXT_SUBVOL"
  sync
  delete_disposable_subvol "$ACTIVE_SUBVOL"
  mv "$TOP/$ACTIVE_NEXT_SUBVOL" "$TOP/$ACTIVE_SUBVOL"
  validate_active "$ACTIVE_SUBVOL"
  sync

  temporary="$TOP/$STATE_SUBVOL/.active-reset-boot-id.$$"
  printf '%s\n' "$boot_id" >"$temporary"
  mv "$temporary" "$marker"
  sync
  log "Fresh $ACTIVE_SUBVOL is ready; no prior runtime was retained"
}

main "$@"
