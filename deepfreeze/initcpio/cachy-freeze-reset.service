[Unit]
Description=Recreate CachyOS frozen Btrfs root
DefaultDependencies=no
# The same unit file is installed in the real root so mkinitcpio can copy it
# into the image.  systemd retains units across switch-root, therefore without
# this guard it can run a second time after /sysroot is mounted.  That second
# reset renames the mounted @active to @active.previous and leaves the system
# running from the wrong subvolume.
ConditionPathExists=/etc/initrd-release
ConditionKernelCommandLine=cachy.freeze=1
After=systemd-udev-trigger.service
Before=initrd-root-fs.target sysroot.mount
OnFailure=emergency.target
OnFailureJobMode=isolate

[Service]
Type=oneshot
ExecStart=/usr/lib/cachy-freeze/cachy-freeze-reset
TimeoutStartSec=90

[Install]
RequiredBy=initrd-root-fs.target
