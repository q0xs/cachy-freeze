[Unit]
Description=Publish CachyFreeze Golden after managed users log out
After=systemd-user-sessions.service var-lib-cachy\x2dfreeze.mount
RequiresMountsFor=/var/lib/cachy-freeze

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cachy-freeze finalize run --timeout 180
# ExecStartPost runs only after a successful finalization.  Using the backend
# preserves the durable reboot audit and keeps failures fail-closed at SDDM.
ExecStartPost=/usr/local/sbin/cachy-freeze reboot
TimeoutStartSec=240
