[Unit]
Description=Verify CachyFreeze boot mode and discard stale THAWED runtime
After=display-manager.service var-lib-cachy\x2dfreeze.mount
Wants=display-manager.service
RequiresMountsFor=/var/lib/cachy-freeze

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cachy-freeze boot-success
TimeoutStartSec=90

[Install]
WantedBy=graphical.target
