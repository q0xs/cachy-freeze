[Unit]
Description=CachyFreeze idle sleep and unattended shutdown policy
After=display-manager.service systemd-logind.service
Wants=display-manager.service
RequiresMountsFor=/var/lib/cachy-freeze
Conflicts=shutdown.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/cachy-freeze idle-power run --poll 15
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes

[Install]
WantedBy=graphical.target
