#!/usr/bin/env bash
set -Eeuo pipefail

readonly INSTALLED_PYTHON_ROOT=/usr/lib/cachy-freeze/python
SOURCE_PYTHON_ROOT="$(
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../src" && pwd
)"
readonly SOURCE_PYTHON_ROOT

if [[ -d $INSTALLED_PYTHON_ROOT/cachy_freeze ]]; then
  python_root=$INSTALLED_PYTHON_ROOT
else
  python_root=$SOURCE_PYTHON_ROOT
fi

export PYTHONPATH=$python_root
export PYTHONNOUSERSITE=1
unset PYTHONHOME
exec /usr/bin/python -s -m cachy_freeze.cli "$@"
