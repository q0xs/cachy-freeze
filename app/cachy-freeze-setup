#!/usr/bin/env bash
set -Eeuo pipefail

PROJECT_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
readonly PROJECT_ROOT

show_error() {
  local message=$1
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --title "CachyFreeze Setup" --error "$message"
  elif command -v zenity >/dev/null 2>&1; then
    zenity --error --title="CachyFreeze Setup" --text="$message"
  else
    printf 'ERROR: %s\n' "$message" >&2
  fi
}

command -v python >/dev/null 2>&1 || {
  show_error "Python was not found. Verify the CachyOS installation."
  exit 1
}
command -v pkexec >/dev/null 2>&1 || {
  show_error "PolicyKit was not found. A CachyOS KDE installation is required."
  exit 1
}

# GitHub ZIP extraction can drop Unix execute bits. The desktop launcher itself
# uses bash, then restores the helper bit before PolicyKit executes it.
chmod u+x "$PROJECT_ROOT/app/cachy-freeze-manager-helper"

if ! python -s -c 'import PyQt6' >/dev/null 2>&1; then
  if ! pkexec /usr/bin/pacman -S --needed --noconfirm python-pyqt6; then
    show_error "The graphical setup component could not be installed. Check the network."
    exit 1
  fi
fi

export PYTHONPATH="$PROJECT_ROOT/src:$PROJECT_ROOT/app"
export PYTHONNOUSERSITE=1
unset PYTHONHOME
exec /usr/bin/python -s -m cachy_freeze_gui.main --setup-source "$PROJECT_ROOT"
