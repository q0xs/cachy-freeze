#!/usr/bin/env bash
set -Eeuo pipefail

readonly BACKEND=/usr/local/sbin/cachy-freeze
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
readonly SCRIPT_DIR
if [[ -d $SCRIPT_DIR/deployment/installer ]]; then
  PROJECT_ROOT=$SCRIPT_DIR/deployment
else
  PROJECT_ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd)
fi
readonly PROJECT_ROOT

export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin
unset CDPATH ENV BASH_ENV PYTHONHOME PYTHONPATH CACHY_FREEZE_CONFIG
unset CACHY_FREEZE_ROOT_SUBVOLUME CACHY_FREEZE_INITRD_CONFIG CACHY_FREEZE_TOP

(( EUID == 0 )) || {
  printf '%s\n' "ERROR: Administrator authorization is required." >&2
  exit 1
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

require_count() {
  local expected=$1
  shift
  (( $# == expected )) || die "Invalid argument count."
}

read_boot_secret() {
  IFS= read -r BOOT_SECRET || die "The boot-maintenance password was not received."
  (( ${#BOOT_SECRET} >= 12 && ${#BOOT_SECRET} <= 256 )) ||
    die "The boot-maintenance password must contain 12-256 characters."
  [[ $BOOT_SECRET != *:* && $BOOT_SECRET != *$'\r'* && $BOOT_SECRET != *$'\n'* ]] ||
    die "The boot-maintenance password contains an unsupported character."
  local classes=0
  [[ $BOOT_SECRET =~ [a-z] ]] && ((classes += 1))
  [[ $BOOT_SECRET =~ [A-Z] ]] && ((classes += 1))
  [[ $BOOT_SECRET =~ [0-9] ]] && ((classes += 1))
  [[ $BOOT_SECRET =~ [^A-Za-z0-9] ]] && ((classes += 1))
  (( classes >= 3 )) || die "Use at least three character classes."
}

case ${1:-} in
  setup-install)
    require_count 1 "$@"
    [[ -r $PROJECT_ROOT/installer/install-cachyfreeze.sh ]] ||
      die "The verified installer payload was not found."
    read_boot_secret
    printf '%s\n' "$BOOT_SECRET" | bash "$PROJECT_ROOT/installer/install-cachyfreeze.sh" >&2
    unset BOOT_SECRET
    status_payload=$("$BACKEND" status)
    if [[ $PROJECT_ROOT == /run/cachyfreeze-installer.* && \
      -f $PROJECT_ROOT/.cachyfreeze-root-staged && \
      ! -L $PROJECT_ROOT && \
      $(stat -c '%u:%a' "$PROJECT_ROOT") == 0:755 ]]; then
      rm -rf --one-file-system "$PROJECT_ROOT"
    fi
    printf '%s\n' "$status_payload"
    ;;
  status | freeze | thaw | reboot)
    require_count 1 "$@"
    [[ -x $BACKEND ]] || die "CachyFreeze is not installed."
    exec "$BACKEND" "$1"
    ;;
  *)
    die "Unsupported CachyFreeze action."
    ;;
esac
