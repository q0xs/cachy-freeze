#!/usr/bin/env python3
"""Installed launcher for the CachyFreeze desktop application."""

from __future__ import annotations

import sys
from pathlib import Path


INSTALLED_ROOT = Path("/usr/lib/cachy-freeze/python")
SOURCE_ROOT = Path(__file__).resolve().parents[1] / "src"
APP_SOURCE_ROOT = Path(__file__).resolve().parent

for candidate in (INSTALLED_ROOT, SOURCE_ROOT, APP_SOURCE_ROOT):
    if candidate.is_dir():
        sys.path.insert(0, str(candidate))

from cachy_freeze_gui.main import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
