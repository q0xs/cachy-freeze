#!/usr/bin/env bash
set -Eeuo pipefail

readonly CONFIG=/etc/cachy-frozen-admin.conf
readonly STATE_DIR=${CACHY_FREEZE_STATE_DIR:-/var/lib/cachy-freeze}
die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

[[ -r $CONFIG ]] || die "Configuration not found: $CONFIG"
# The file is created by root during installation and is writable only by root.
# shellcheck disable=SC1090
source "$CONFIG"

[[ ${ADMIN_USER:-} =~ ^[a-z][a-z0-9_-]{1,31}$ ]] ||
  die "Invalid administrator account."
id "$ADMIN_USER" >/dev/null 2>&1 ||
  die "Administrator account not found: $ADMIN_USER"

# Password, shell, and group privileges remain unchanged, allowing PolicyKit to
# use this account for administrator authentication in the employee session.
# The account is hidden only from the graphical login screen; a separate service
# restores its home directory from the clean template on every FROZEN boot.
admin_home=$(getent passwd "$ADMIN_USER" | cut -d: -f6)
[[ -n $admin_home && -d $admin_home ]] && chmod 0700 "$admin_home"

install -d -m 0755 /var/lib/AccountsService/users
cat >"/var/lib/AccountsService/users/$ADMIN_USER" <<EOF
[User]
SystemAccount=true
EOF
chmod 0600 "/var/lib/AccountsService/users/$ADMIN_USER"

boot_id=$(< /proc/sys/kernel/random/boot_id)
[[ $boot_id =~ ^[0-9a-f-]{36}$ ]] || die "Current boot id is invalid."
[[ -d $STATE_DIR ]] || die "CachyFreeze state directory is unavailable."
marker=$STATE_DIR/admin-restrict-boot-id
temporary=$STATE_DIR/.admin-restrict-boot-id.$$
umask 077
printf '%s\n' "$boot_id" >"$temporary"
mv "$temporary" "$marker"
