#!/usr/bin/env bash
set -Eeuo pipefail

# Plasma 6'nin normal oturum kapatma ekranini kullan.
if command -v qdbus6 >/dev/null &&
  qdbus6 org.kde.Shutdown /Shutdown logout; then
  exit 0
fi

# Eski Plasma surumleri icin uyumluluk.
if command -v qdbus >/dev/null &&
  qdbus org.kde.ksmserver /KSMServer logout 0 0 3; then
  exit 0
fi

printf '%s\n' \
  "Otomatik oturum kapatma ekrani acilamadi." \
  "Uygulama menusunden Oturumu Kapat secenegini kullanin." >&2
exit 1

