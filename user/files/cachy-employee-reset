#!/usr/bin/env bash
set -Eeuo pipefail

readonly TEMPLATE_ROOT=${CACHY_USER_TEMPLATE_ROOT:-/var/lib/cachy-user-template}
readonly STATE_DIR=${CACHY_FREEZE_STATE_DIR:-/var/lib/cachy-freeze}

[[ -d $TEMPLATE_ROOT ]] || exit 0

for candidate in "$TEMPLATE_ROOT"/*.next; do
  [[ -d $candidate ]] || continue
  username=${candidate##*/}
  username=${username%.next}
  [[ $username =~ ^[a-z_][a-z0-9_-]{0,30}$ ]] || continue
  if [[ ! -e $TEMPLATE_ROOT/$username ]]; then
    mv "$candidate" "$TEMPLATE_ROOT/$username"
  else
    rm -rf --one-file-system "$candidate"
  fi
done

for previous in "$TEMPLATE_ROOT"/*.previous; do
  [[ -d $previous ]] || continue
  username=${previous##*/}
  username=${username%.previous}
  [[ $username =~ ^[a-z_][a-z0-9_-]{0,30}$ ]] || continue
  if [[ ! -e $TEMPLATE_ROOT/$username ]]; then
    mv "$previous" "$TEMPLATE_ROOT/$username"
  fi
done

for template in "$TEMPLATE_ROOT"/*; do
  [[ -d $template ]] || continue
  username=${template##*/}
  [[ $username =~ ^[a-z_][a-z0-9_-]{0,30}$ ]] || continue
  home=$(getent passwd "$username" | cut -d: -f6)
  [[ -n $home && -d $home ]] || continue
  rsync -aHAX --delete "$template/" "$home/"
  chown -R "$username:$username" "$home"
done

boot_id=$(< /proc/sys/kernel/random/boot_id)
[[ $boot_id =~ ^[0-9a-f-]{36}$ ]] || {
  printf '%s\n' "ERROR: Current boot id is invalid." >&2
  exit 1
}
[[ -d $STATE_DIR ]] || {
  printf '%s\n' "ERROR: CachyFreeze state directory is unavailable." >&2
  exit 1
}
marker=$STATE_DIR/home-reset-boot-id
temporary=$STATE_DIR/.home-reset-boot-id.$$
umask 077
printf '%s\n' "$boot_id" >"$temporary"
mv "$temporary" "$marker"
