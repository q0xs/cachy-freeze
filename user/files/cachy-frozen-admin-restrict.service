[Unit]
Description=Hide administrator from the graphical login in CachyOS frozen mode
ConditionKernelCommandLine=cachy.freeze=1
After=local-fs.target
Before=systemd-user-sessions.service display-manager.service sshd.service
RequiresMountsFor=/var/lib/cachy-freeze

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cachy-frozen-admin-restrict
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
