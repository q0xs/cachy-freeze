[Desktop Entry]
Type=Application
Name=CachyOS Kurulum Uygulaması
GenericName=CachyOS Workstation Kurulumu
Comment=Kurulumu ve Cachy Freeze yönetimini tek uygulamadan yap
Exec=/usr/bin/bash -c "launcher=\"$(dirname -- \"$1\")/app/cachy-freeze-setup\"; exec /usr/bin/bash \"$launcher\"" bootstrap %k
Icon=system-software-install
Terminal=false
Categories=System;Settings;
Keywords=cachyos;kurulum;freeze;dondur;setup;
StartupNotify=true
