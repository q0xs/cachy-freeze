[Desktop Entry]
Type=Application
Name=CachyFreeze Setup
GenericName=CachyOS Workstation Setup
Comment=Install and manage CachyFreeze from one application
Exec=/usr/bin/bash -c "desktop=\\$1; desktop=\\${desktop#file://}; launcher=\\${desktop%%/*}/app/cachy-freeze-setup; IFS=; set -f; exec /usr/bin/bash \\$launcher" bootstrap %k
Icon=cachy-freeze
Terminal=false
Categories=System;
Keywords=cachyos;workstation;freeze;thaw;setup;
StartupNotify=true
