* text=auto

# Linux'ta çalıştırılan dosyalarda CRLF kaynaklı hataları önle
*.sh text eol=lf
*.service text eol=lf
*.desktop text eol=lf
*.conf text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

/deepfreeze/bin/* text eol=lf
/deepfreeze/grub/* text eol=lf
/deepfreeze/initcpio/* text eol=lf
/installer/lib/* text eol=lf
/user/files/* text eol=lf
/app/* text eol=lf
/src/**/*.py text eol=lf
/tests/**/*.py text eol=lf

*.png binary
*.zip binary
